# Copy to .env.local and fill in (never commit .env.local).
#   cp .env.example .env.local

# --- OAuth 2.0 (required for this plugin / xurl / ChatGPT) ---
CLIENT_ID=
CLIENT_SECRET=

# --- Keys shown on the X dashboard (optional to keep; not used by the MCP plugin) ---
# OAuth 1.0a
CONSUMER_KEY=
CONSUMER_SECRET=
# App-only (no user context — cannot read personal bookmarks)
BEARER_TOKEN=

# Optional short-lived user-context token for npm run verify
# Prefer: X_TOKEN=$(xurl token) npm run verify
X_TOKEN=
