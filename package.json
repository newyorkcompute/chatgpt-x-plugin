{
  "name": "chatgpt-x-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "DIY ChatGPT plugin for X (Twitter) via api.x.com/mcp — bookmarks, search, and more",
  "type": "module",
  "scripts": {
    "configure": "tsx scripts/configure.ts",
    "check:template": "tsx scripts/check-template.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx scripts/validate-manifests.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:discovery": "tsx scripts/verify.ts --discovery-only",
    "ci": "npm run lint && npm run typecheck && npm run check:template && npm run validate && npm run verify:discovery"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newyorkcompute/chatgpt-x-plugin.git"
  },
  "keywords": [
    "chatgpt",
    "plugin",
    "mcp",
    "x",
    "twitter",
    "bookmarks"
  ],
  "author": "newyorkcompute",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/newyorkcompute/chatgpt-x-plugin/issues"
  },
  "homepage": "https://github.com/newyorkcompute/chatgpt-x-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
